# ---- FaceGate backend configuration (copy to .env) ----
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://facegate:facegate@localhost:5432/facegate
CORS_ORIGINS=["http://localhost:5173","https://attendance.example.com"]

# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TEMPLATE_KEY=change-me-32-random-bytes-base64
COOKIE_SECURE=false

# 0 = one worker per physical core
INFERENCE_WORKERS=0
# Face model: intel-fr-0095 (default, OpenVINO) or sface-2021dec. Changing it requires re-enrolling everyone.
FACE_MODEL=intel-fr-0095
MATCH_ACCEPT_THRESHOLD=0.45
MATCH_MARGIN=0.08
PAD_LIVE_THRESHOLD=0.80
ORG_TIMEZONE=Europe/London
WORK_START=09:00
WORK_END=17:30
