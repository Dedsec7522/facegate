proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
# Overwrite, never append: nginx is the edge, so a client-sent X-Forwarded-For is untrusted. The API takes the first
# entry (uvicorn --forwarded-allow-ips '*'), which with $proxy_add_x_forwarded_for would be the client's own choice.
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_read_timeout 180s;
proxy_send_timeout 180s;
proxy_buffering off;
