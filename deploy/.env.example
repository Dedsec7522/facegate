# ---- FaceGate deployment secrets (copy to deploy/.env; never commit .env) ----
PUBLIC_HOST=attendance.example.com

POSTGRES_USER=facegate
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=facegate

# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-long-random
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TEMPLATE_KEY=change-me-32-random-bytes-base64

# CPU cores reserved for inference (also sets the bounded inference pool)
API_CPUS=4
INFERENCE_WORKERS=4

ORG_TIMEZONE=Europe/London
WORK_START=09:00
WORK_END=17:30
MATCH_ACCEPT_THRESHOLD=0.45
# Real webcams score 0.4-0.85 on passive liveness; keep 0.45 (see backend/.env.example)
PAD_LIVE_THRESHOLD=0.45
KEEP_ENROL_THUMBNAIL=true
